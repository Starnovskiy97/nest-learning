# Shared by workers of ONE Nginx instance, not by separate containers.
limit_req_zone $binary_remote_addr zone=login_per_ip:10m rate=10r/m;

# Round-robin is the default. The optional line adds a second lab instance.
upstream api_backend {
    zone api_backend 64k;
    # Cache idle HTTP connections per worker; this is not a concurrency limit.
    keepalive 16;
    server ${API_UPSTREAM};
    ${API_EXTRA_SERVER}
}

# No Authorization, request bodies or query strings in this access log.
log_format api '$remote_addr $request_method $uri status=$status '
               'upstream=$upstream_addr status_upstream=$upstream_status '
               'limit=$limit_req_status';

server {
    listen 80;
    server_name _;
    server_tokens off;
    access_log /var/log/nginx/access.log api;
    # Teaching aid only: remove internal addresses from public production responses.
    add_header X-Upstream-Addr $upstream_addr always;

    client_max_body_size 16k;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    # This lab has no trusted proxy in front of Nginx. Overwrite client headers.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
    proxy_next_upstream off;

    limit_req_status 429;
    limit_req_log_level notice;
    error_page 429 = @rate_limited;

    # Match Express's default case-insensitive routes and optional final slash.
    # Query strings do not participate in location matching.
    location ~* ^/auth/login/?$ {
        limit_req zone=login_per_ip burst=5 nodelay;
        proxy_pass http://api_backend;
    }

    location / {
        proxy_pass http://api_backend;
    }

    location @rate_limited {
        default_type application/json;
        add_header Cache-Control no-store always;
        return 429 '{"statusCode":429,"message":"Too many requests","error":"Too Many Requests"}';
    }
}
