generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int     @id @default(autoincrement())
  name         String
  email        String? @unique
  passwordHash String?
  tasks        Task[]
}

model Task {
  id         Int     @id @default(autoincrement())
  title      String
  completed  Boolean @default(false)
  assigneeId Int?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: Restrict)

  @@index([assigneeId])
}
