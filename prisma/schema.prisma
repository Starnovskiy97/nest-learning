generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int                   @id @default(autoincrement())
  name                 String
  email                String?               @unique
  passwordHash         String?
  tasks                Task[]                @relation("TaskAssignee")
  ownedTasks           Task[]                @relation("TaskOwner")
  taskCreationRequests TaskCreationRequest[]
}

model Task {
  id         Int     @id @default(autoincrement())
  title      String
  completed  Boolean @default(false)
  assigneeId Int?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  ownerId    Int?
  owner      User?   @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([assigneeId])
  @@index([ownerId, id])
}

// Snapshot of a successful POST /tasks, intentionally independent of Task lifetime.
model TaskCreationRequest {
  ownerId Int
  key     String @db.Uuid
  title   String
  taskId  Int
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@id([ownerId, key])
}
