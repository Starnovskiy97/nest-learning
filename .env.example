# Только для локальной учебной базы из compose.yaml.
DATABASE_URL="postgresql://nest:nest_dev_password@localhost:5433/nest_learning?schema=public"

# Сгенерировать свой секрет: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Пустое значение отключает кэш. Этот адрес также используется по умолчанию.
REDIS_URL=redis://127.0.0.1:6380
# Должен быть разным для разных окружений/баз, использующих общий Redis.
TASK_CACHE_NAMESPACE=nest-learning:tasks:v1
